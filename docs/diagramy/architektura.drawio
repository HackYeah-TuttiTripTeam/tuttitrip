<mxCell id="s1" value="&lt;b&gt;S1 (System 1): szybko&lt;/b&gt;&lt;br&gt;algorytm zadowolenia (solver), sprawdzenie&lt;br&gt;planu, reguły cen: czysta logika&lt;br&gt;+ modele decyzyjne basal, Laya, JEV&lt;br&gt;(wybór jednej z maks. 10 opcji)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCF2E6;strokeColor=#00774D;strokeWidth=2;fontSize=17;fontFamily=Arial;fontColor=#10241C;" vertex="1" parent="1"><mxGeometry x="940" y="260" width="410" height="140" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;S2 (System 2): LLM pisze na żądanie S1&lt;/b&gt;&lt;br&gt;Qwen3.8-27B, wywiad przez AG-UI&lt;br&gt;przejmuje, gdy model decyzyjny nie umie" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5E55;strokeWidth=2;fontSize=17;fontFamily=Arial;fontColor=#10241C;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="410" height="110" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;S3: czeka na zgodę człowieka&lt;/b&gt;&lt;br&gt;karta zatwierdzenia: przekroczenie&lt;br&gt;budżetu, wyszukiwanie noclegów" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00774D;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=17;fontFamily=Arial;fontColor=#10241C;" vertex="1" parent="1"><mxGeometry x="940" y="550" width="410" height="110" as="geometry"/></mxCell>
