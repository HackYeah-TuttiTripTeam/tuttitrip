---
config:
  theme: base
  themeVariables:
    fontFamily: arial
    lineColor: "#59636E"
    usecaseActorBkg: "#FFFFFF"
    usecaseActorBorder: "#3C4650"
    usecaseBoundaryBkg: "#FAFAF7"
    usecaseBoundaryBorder: "#8C8C84"
  usecase:
    useMaxWidth: false
    usecaseFontSize: 20
    usecaseFontFamily: arial
    actorFontSize: 20
    actorFontFamily: arial
    wrappingWidth: 230
---
%% Legenda kolorów i relacji.
usecase-beta
direction LR
systemBoundary leg["Legenda"]
  a("Istniejąca user story"):::ist
  b("Nowa user story (ze słownika)"):::nowa
  c("Przypadek rozszerzający"):::ist
  d("Przypadek bazowy"):::ist
  e("Przypadek dołączany"):::ist
end
c ..>:extend d
d ..>:include e
classDef ist fill:#CFE0F5,stroke:#4F74A8,color:#1F2933
classDef nowa fill:#F3F7FC,stroke:#A9BEDB,color:#3A4654,stroke-dasharray:5 4
