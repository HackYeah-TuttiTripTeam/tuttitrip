---
config:
  theme: base
  themeVariables:
    fontFamily: arial
    lineColor: "#59636E"
    usecaseActorBkg: "#FFFFFF"
    usecaseActorBorder: "#3C4650"
    usecaseBoundaryBkg: "#FAFAF7"
    usecaseBoundaryBorder: "#8C8C84"
  usecase:
    useMaxWidth: false
    usecaseFontSize: 20
    usecaseFontFamily: arial
    actorFontSize: 20
    actorFontFamily: arial
    wrappingWidth: 230
---
%% Domena: Administracja. Jasne, przerywane elipsy (klasa nowa) to nowe user stories ze słownika.
usecase-beta
direction LR
actor adm("Administrator systemu")
systemBoundary sys_admin["Administracja"]
  lista("Przeglądaj użytkowników"):::nowa
  blok("Zablokuj konto"):::nowa
  usun("Usuń użytkownika"):::ist
  upr("Nadaj lub odbierz uprawnienia"):::nowa
  wagi("Ustaw parametry i wagi algorytmu"):::ist
end
adm -- lista
adm -- upr
adm -- wagi
blok ..>:extend lista
usun ..>:extend lista
classDef ist fill:#CFE0F5,stroke:#4F74A8,color:#1F2933
classDef nowa fill:#F3F7FC,stroke:#A9BEDB,color:#3A4654,stroke-dasharray:5 4
