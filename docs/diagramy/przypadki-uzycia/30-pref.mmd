%% Domena: Preferencje i wywiad. Jasne, przerywane elipsy (klasa nowa) to nowe user stories ze słownika.
usecase-beta
direction LR
actor cz("Członek podróży")
actor host("Host")
systemBoundary sys_pref["Preferencje i wywiad"]
  pref("Podaj preferencje"):::ist
  zai("Podaj zainteresowania"):::ist
  ogr("Podaj ograniczenia zdrowotne"):::ist
  lub("Wskaż lubiane i nielubiane miejsca"):::ist
  wyw("Porozmawiaj z asystentem"):::ist
  pula("Rozdziel pulę ważności"):::nowa
  start("Zacznij planowanie jednym zdaniem"):::nowa
  prz("Przerwij i wznów wywiad"):::nowa
  wst("Zobacz plan wstępny"):::nowa
  uzu("Uzupełnij preferencje za innych"):::ist
  pob("Pobierz preferencje członków"):::ist
end
cz -- pref
cz -- wyw
cz -- pula
host -- start
host -- uzu
host -- pob
pref ..>:include zai
pref ..>:include ogr
pref ..>:include lub
start ..>:include wyw
prz ..>:extend wyw
wst ..>:extend wyw
classDef ist fill:#CFE0F5,stroke:#4F74A8,color:#1F2933
classDef nowa fill:#F3F7FC,stroke:#A9BEDB,color:#3A4654,stroke-dasharray:5 4
