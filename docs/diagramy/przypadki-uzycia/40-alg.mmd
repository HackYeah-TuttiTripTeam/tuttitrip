---
config:
  theme: base
  themeVariables:
    fontFamily: arial
    lineColor: "#59636E"
    usecaseActorBkg: "#FFFFFF"
    usecaseActorBorder: "#3C4650"
    usecaseBoundaryBkg: "#FAFAF7"
    usecaseBoundaryBorder: "#8C8C84"
  usecase:
    useMaxWidth: false
    usecaseFontSize: 20
    usecaseFontFamily: arial
    actorFontSize: 20
    actorFontFamily: arial
    wrappingWidth: 230
---
%% Domena: Algorytm i decyzje o miejscach. Jasne, przerywane elipsy (klasa nowa) to nowe user stories ze słownika.
usecase-beta
direction LR
actor host("Host")
actor cz("Członek podróży")
actor gosc("Osoba bez konta (link głosowy)")
systemBoundary sys_alg["Algorytm i decyzje o miejscach"]
  alg("Ułóż plan algorytmem"):::ist
  pod("Zachowaj podłogę zadowolenia"):::nowa
  pow("Daj ten sam plan dla tych samych danych"):::nowa
  wag("Zmień wagi członków"):::ist
  spr("Zobacz miarę sprawiedliwości"):::nowa
  ksi("Zobacz księgę sprawiedliwości"):::nowa
  ovr("Wymuś lub zablokuj miejsce"):::nowa
  kov("Zobacz koszt override"):::nowa
  bud("Ustaw budżet od–do"):::nowa
  prk("Zatwierdź przekroczenie budżetu"):::nowa
  lnk("Wyślij link głosowy"):::nowa
  oce("Oceń miejsce"):::ist
  pwd("Wskaż powód odrzucenia"):::nowa
  weto("Zgłoś weto"):::nowa
  wza("Zgłoś weto za inną osobę"):::nowa
  wer("Zobacz werdykt miejsca"):::nowa
end
host -- wag
host -- spr
host -- ksi
host -- ovr
host -- bud
host -- prk
host -- lnk
host -- wza
cz -- oce
cz -- weto
cz -- wer
gosc -- oce
gosc -- weto
alg ..>:include pod
alg ..>:include pow
ovr ..>:include kov
pwd ..>:extend oce
wza ..>:extend weto
weto ..>:include alg
classDef ist fill:#CFE0F5,stroke:#4F74A8,color:#1F2933
classDef nowa fill:#F3F7FC,stroke:#A9BEDB,color:#3A4654,stroke-dasharray:5 4
