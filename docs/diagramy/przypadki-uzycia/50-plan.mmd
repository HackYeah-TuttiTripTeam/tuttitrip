---
config:
  theme: base
  themeVariables:
    fontFamily: arial
    lineColor: "#59636E"
    usecaseActorBkg: "#FFFFFF"
    usecaseActorBorder: "#3C4650"
    usecaseBoundaryBkg: "#FAFAF7"
    usecaseBoundaryBorder: "#8C8C84"
  usecase:
    useMaxWidth: false
    usecaseFontSize: 20
    usecaseFontFamily: arial
    actorFontSize: 20
    actorFontFamily: arial
    wrappingWidth: 230
---
%% Domena: Plan podróży. Jasne, przerywane elipsy (klasa nowa) to nowe user stories ze słownika.
usecase-beta
direction LR
actor host("Host")
actor cz("Członek podróży")
systemBoundary sys_plan["Plan podróży"]
  wys("Wyślij propozycję planu"):::ist
  dec("Zatwierdź, odrzuć lub skomentuj plan"):::ist
  pob2("Pobierz zatwierdzony plan"):::ist
  pdf("Wydrukuj plan lub zapisz PDF"):::nowa
  lin("Sprawdź wklejony plan linterem"):::nowa
  kal("Zapisz plan w kalendarzu"):::nowa
end
host -- wys
host -- lin
host -- kal
host -- pdf
cz -- dec
cz -- pob2
pdf ..>:extend pob2
classDef ist fill:#CFE0F5,stroke:#4F74A8,color:#1F2933
classDef nowa fill:#F3F7FC,stroke:#A9BEDB,color:#3A4654,stroke-dasharray:5 4
