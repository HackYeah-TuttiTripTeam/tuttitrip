%% Domena: Miejsca, noclegi i transport. Jasne, przerywane elipsy (klasa nowa) to nowe user stories ze słownika.
usecase-beta
direction LR
actor cz("Członek podróży")
actor host("Host")
systemBoundary sys_miej["Miejsca, noclegi i transport"]
  wyc("Wybierz gotową wycieczkę z ceną"):::ist
  noc("Zobacz nocleg z ceną"):::ist
  uni("Poznaj unikalne doświadczenia"):::ist
  prj("Zobacz przejazdy i ceny biletów"):::nowa
  kos("Zobacz koszt na osobę z ulgami"):::nowa
  wer2("Sprawdź, czy cena i godziny są zweryfikowane"):::nowa
  wym("Ustaw wymagania noclegowe"):::nowa
  ofe("Sprawdź wklejoną ofertę"):::nowa
  nat("Rozważ noc-atrakcję"):::nowa
  szu("Otwórz wyszukiwanie noclegów"):::nowa
end
cz -- wyc
cz -- noc
cz -- uni
cz -- prj
cz -- kos
cz -- wer2
host -- wym
host -- nat
host -- szu
ofe ..>:extend wym
classDef ist fill:#CFE0F5,stroke:#4F74A8,color:#1F2933
classDef nowa fill:#F3F7FC,stroke:#A9BEDB,color:#3A4654,stroke-dasharray:5 4
